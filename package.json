{
  "name": "@odatano/dpp-sdk",
  "version": "0.3.0",
  "description": "Chain-agnostic Digital Product Passport domain SDK: product profiles, canonical hashing, payload projection, access levels, merkle proofs, lifecycles, ZK claim planning. Ships an EU Battery Regulation profile.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ODATANO/DPP-SDK.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./hash": {
      "types": "./dist/hash.d.ts",
      "import": "./dist/hash.mjs",
      "require": "./dist/hash.js",
      "default": "./dist/hash.js"
    },
    "./bytes": {
      "types": "./dist/bytes.d.ts",
      "import": "./dist/bytes.mjs",
      "require": "./dist/bytes.js",
      "default": "./dist/bytes.js"
    },
    "./cipher": {
      "types": "./dist/cipher.d.ts",
      "import": "./dist/cipher.mjs",
      "require": "./dist/cipher.js",
      "default": "./dist/cipher.js"
    },
    "./grantee": {
      "types": "./dist/grantee.d.ts",
      "import": "./dist/grantee.mjs",
      "require": "./dist/grantee.js",
      "default": "./dist/grantee.js"
    },
    "./access": {
      "types": "./dist/access.d.ts",
      "import": "./dist/access.mjs",
      "require": "./dist/access.js",
      "default": "./dist/access.js"
    },
    "./attributes": {
      "types": "./dist/attributes.d.ts",
      "import": "./dist/attributes.mjs",
      "require": "./dist/attributes.js",
      "default": "./dist/attributes.js"
    },
    "./fields": {
      "types": "./dist/fields.d.ts",
      "import": "./dist/fields.mjs",
      "require": "./dist/fields.js",
      "default": "./dist/fields.js"
    },
    "./profile": {
      "types": "./dist/profile.d.ts",
      "import": "./dist/profile.mjs",
      "require": "./dist/profile.js",
      "default": "./dist/profile.js"
    },
    "./merkle": {
      "types": "./dist/merkle.d.ts",
      "import": "./dist/merkle.mjs",
      "require": "./dist/merkle.js",
      "default": "./dist/merkle.js"
    },
    "./lifecycle": {
      "types": "./dist/lifecycle.d.ts",
      "import": "./dist/lifecycle.mjs",
      "require": "./dist/lifecycle.js",
      "default": "./dist/lifecycle.js"
    },
    "./claim-sets": {
      "types": "./dist/claim-sets.d.ts",
      "import": "./dist/claim-sets.mjs",
      "require": "./dist/claim-sets.js",
      "default": "./dist/claim-sets.js"
    },
    "./claim-cart": {
      "types": "./dist/claim-cart.d.ts",
      "import": "./dist/claim-cart.mjs",
      "require": "./dist/claim-cart.js",
      "default": "./dist/claim-cart.js"
    },
    "./store": {
      "types": "./dist/store.d.ts",
      "import": "./dist/store.mjs",
      "require": "./dist/store.js",
      "default": "./dist/store.js"
    },
    "./upload": {
      "types": "./dist/upload.d.ts",
      "import": "./dist/upload.mjs",
      "require": "./dist/upload.js",
      "default": "./dist/upload.js"
    },
    "./token": {
      "types": "./dist/token.d.ts",
      "import": "./dist/token.mjs",
      "require": "./dist/token.js",
      "default": "./dist/token.js"
    },
    "./stuck-rows": {
      "types": "./dist/stuck-rows.d.ts",
      "import": "./dist/stuck-rows.mjs",
      "require": "./dist/stuck-rows.js",
      "default": "./dist/stuck-rows.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "import": "./dist/http.mjs",
      "require": "./dist/http.js",
      "default": "./dist/http.js"
    },
    "./battery/*": {
      "types": "./dist/battery/*.d.ts",
      "import": "./dist/battery/*.mjs",
      "require": "./dist/battery/*.js",
      "default": "./dist/battery/*.js"
    },
    "./integrations/*": {
      "types": "./dist/integrations/*.d.ts",
      "import": "./dist/integrations/*.mjs",
      "require": "./dist/integrations/*.js",
      "default": "./dist/integrations/*.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "dist/*": [
        "./dist/*"
      ],
      "*": [
        "./dist/*"
      ]
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.mjs",
    "dist/**/*.d.ts",
    "dist/**/*.d.mts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"test/unit/**/*.test.ts\"",
    "test:ci": "node --import tsx --test-reporter=spec --test \"test/unit/**/*.test.ts\"",
    "check:consumers": "node scripts/check-consumer-resolution.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test && npm run build && npm run check:consumers"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsup": "^8",
    "tsx": "^4",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "digital-product-passport",
    "dpp",
    "espr",
    "battery-passport",
    "merkle",
    "blake2b",
    "zero-knowledge"
  ]
}
